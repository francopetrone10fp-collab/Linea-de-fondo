# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Nunca exponer al cliente / nunca commitear con un valor real.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Notificaciones push del navegador (generar una única vez con
# `npx web-push generate-vapid-keys` y no volver a regenerar: si cambian,
# todos los que ya se suscribieron tienen que activarlas de nuevo).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@lineadefondo.app
# Secreto que Vercel Cron manda en el header Authorization al pegarle a
# /api/cron/*. Cualquier string largo y random sirve.
CRON_SECRET=
